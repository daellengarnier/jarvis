 src/app/api/anlaesse/route.ts      |   13 +-
 src/lib/standardRessorts.ts        |   12 +
 5 files changed, 3145 insertions(+), 1 deletion(-)
 create mode 100644 drizzle/0029_standard-ressorts.sql
