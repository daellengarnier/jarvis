+-- Protokolle der Sitzungen 26.10.2026 und 27.11.2026 ins HQ-Ressort «Sitzungen»,
+-- dazu die nächste Sitzung 18.01.2027.
+--
+-- Hintergrund: 0033 hat den 26.10. übersprungen, weil es an dem Datum schon eine
+-- (leere) Sitzung gab, und 0035 befüllt nur importierte Sitzungen. Darum füllt
+-- diese Migration bestehende Sitzungen auf, statt sie zu überspringen:
+--   * Sitzung am Datum wird gefunden oder angelegt.
+--   * Leitung/Protokollführung/Protokoll nur, wenn noch leer.
+--   * Traktandum mit gleichem Titel: Notizen nur, wenn noch leer. Sonst neu.
+--   * Pendenzen (Todos) nur, wenn es an der Sitzung noch keine mit gleichem Titel gibt.
+-- Inhalte, die in der App schon erfasst sind, werden nicht überschrieben
+-- (nur die Reihenfolge der gleichnamigen Traktanden wird gesetzt).
+
+CREATE OR REPLACE FUNCTION pg_temp.j_sitzung(rid integer, d text, zeit text) RETURNS integer AS $f$
+DECLARE sid integer;
+BEGIN
+  SELECT id INTO sid FROM sitzungen WHERE "ressortId" = rid AND datum = d ORDER BY id LIMIT 1;
+  IF sid IS NULL THEN
+    INSERT INTO sitzungen ("ressortId", datum, startzeit, ort, protokoll)
+    VALUES (rid, d, zeit, '', '') RETURNING id INTO sid;
+  ELSIF zeit <> '' THEN
+    UPDATE sitzungen SET startzeit = zeit WHERE id = sid AND startzeit = '';
+  END IF;
+  RETURN sid;
+END $f$ LANGUAGE plpgsql;
+
+CREATE OR REPLACE FUNCTION pg_temp.j_kopf(sid integer, leitung text, prot text, notiz text, wer text[]) RETURNS void AS $f$
+BEGIN
+  UPDATE sitzungen SET sitzungsleitung = leitung WHERE id = sid AND sitzungsleitung = '';
+  UPDATE sitzungen SET protokollfuehrung = prot WHERE id = sid AND protokollfuehrung = '';
+  IF notiz <> '' THEN
+    UPDATE sitzungen SET protokoll = notiz WHERE id = sid AND protokoll = '';
+  END IF;
+  INSERT INTO sitzung_anwesende ("sitzungId", "userId")
+    SELECT sid, id FROM users WHERE name = ANY (wer) ON CONFLICT DO NOTHING;
+END $f$ LANGUAGE plpgsql;
+
+CREATE OR REPLACE FUNCTION pg_temp.j_traktandum(sid integer, titel text, notiz text, pos integer, fertig boolean, autor integer) RETURNS integer AS $f$
+DECLARE tid integer;
+BEGIN
+  SELECT id INTO tid FROM traktanden WHERE "sitzungId" = sid AND text = titel ORDER BY id LIMIT 1;
+  IF tid IS NULL THEN
+    INSERT INTO traktanden ("sitzungId", text, notizen, reihenfolge, erledigt, "erstelltVon")
+    VALUES (sid, titel, notiz, pos, fertig, autor) RETURNING id INTO tid;
+  ELSE
+    UPDATE traktanden SET notizen = notiz WHERE id = tid AND notizen = '' AND notiz <> '';
+    UPDATE traktanden SET reihenfolge = pos WHERE id = tid;
+    IF fertig THEN
+      UPDATE traktanden SET erledigt = true WHERE id = tid;
+    END IF;
+  END IF;
+  RETURN tid;
+END $f$ LANGUAGE plpgsql;
+
+-- erledigt_notiz NULL = offen, sonst erledigt per Sitzung 27.11.2026.
+CREATE OR REPLACE FUNCTION pg_temp.j_todo(rid integer, sid integer, tid integer, t text, beschr text, frist text, wer text[], erledigt_notiz text, autor integer) RETURNS void AS $f$
+DECLARE neu integer;
+BEGIN
+  IF EXISTS (SELECT 1 FROM todos WHERE "sitzungId" = sid AND titel = t) THEN
+    RETURN;
+  END IF;
+  INSERT INTO todos ("ressortId", "sitzungId", "traktandumId", titel, beschreibung, "fristDatum", status, "erledigtAm", "erledigtNotiz", "erstelltVon")
+  VALUES (
+    rid, sid, tid, t, beschr, frist,
+    CASE WHEN erledigt_notiz IS NULL THEN 'offen' ELSE 'erledigt' END,
+    CASE WHEN erledigt_notiz IS NULL THEN NULL ELSE timestamptz '2026-11-27 21:00:00+01' END,
+    COALESCE(erledigt_notiz, ''), autor
+  ) RETURNING id INTO neu;
+  INSERT INTO todo_assignees ("todoId", "userId") SELECT neu, id FROM users WHERE name = ANY (wer);
+END $f$ LANGUAGE plpgsql;
+
+CREATE OR REPLACE FUNCTION pg_temp.j_booking(t text, notiz text, link text, von text) RETURNS void AS $f$
+BEGIN
+  INSERT INTO booking_anfragen ("ressortId", titel, notiz, link, "erstelltVon")
+  SELECT b.id, t, notiz, link, (SELECT id FROM users WHERE name = von LIMIT 1)
+  FROM ressorts b
+  WHERE b."anlassId" IS NULL AND b."hatBooking" = true
+    AND NOT EXISTS (SELECT 1 FROM booking_anfragen a WHERE a."ressortId" = b.id AND a.titel = t)
+  ORDER BY b.id
+  LIMIT 1;
+END $f$ LANGUAGE plpgsql;
